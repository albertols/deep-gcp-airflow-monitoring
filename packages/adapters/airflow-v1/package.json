{
  "name": "@dcam/airflow-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Airflow REST API v1 (Airflow 2) client behind the AirflowApi port: Zod at the boundary, errors as SourceError. Spec Appendix B, FR-COLL-08.",
